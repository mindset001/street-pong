# Copy to .env and edit. Real environment variables take precedence over this file.
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/street

# Required in production: long random string used to sign login tokens.
# (If unset, one is generated and kept in data/jwt.secret, which is lost on ephemeral hosts.)
# JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated origins allowed to call the API/WebSocket from a separately hosted frontend.
# Leave unset when the backend serves the frontend itself (local dev).
# CORS_ORIGIN=https://your-frontend.example.com

# Set to 1 when behind a reverse proxy (Render, Fly, Heroku, nginx) so rate limiting sees real client IPs.
# TRUST_PROXY=1

# Optional TURN/STUN servers for voice chat (JSON array)
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
